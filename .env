# Database connection string (SQLAlchemy async URL)
# Accepted formats: sqlite+aiosqlite:///path or postgresql+asyncpg://user:pass@host:port/dbname
# DATABASE_URL=sqlite+aiosqlite:///./dev.db
#CUANDO SOLO BASE DE DATOS CORRE EN UN CONTENEDOR DOCKER
# DATABASE_URL=postgresql+asyncpg://mike:123456@localhost:5432/postgres
#CUANDO BASE DE DATOS CORRE EN UN CONTENEDOR DOCKER Y LA APP EN OTRO CONTENEDOR, ES NECESARIO CREAR UNA RED ENTRE AMBOS
DATABASE_URL=postgresql+asyncpg://mike:123456@postgres:5432/postgres

# Comma-separated list of allowed CORS origins
# Each origin should be a full URL (scheme + host + port). Wildcard '*' is NOT permitted.
ALLOWED_ORIGINS=*

# Python logging level for the root logger
# Accepted values: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Secret key used for signing and verifying JWT tokens
# Use a long, random string (e.g., 64+ hex characters)
JWT_SECRET=change-me-to-a-random-secret-key

# Discord webhook URL for sending alert notifications
# Format: https://discord.com/api/webhooks/{webhook_id}/{webhook_token}
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/000000000000000000/your-webhook-token-here

# Filesystem path where uploaded media files (photos, videos) are stored
# Can be an absolute path or relative to the project root
MEDIA_ROOT=./media
